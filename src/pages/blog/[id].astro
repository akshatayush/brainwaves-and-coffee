---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { readingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: sorted[i + 1]
        ? { title: sorted[i + 1].data.title, href: `/blog/${sorted[i + 1].id}` }
        : undefined,
      nextPost: sorted[i - 1]
        ? { title: sorted[i - 1].data.title, href: `/blog/${sorted[i - 1].id}` }
        : undefined,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const time = post.body ? readingTime(post.body) : undefined;
---

<Post
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  tags={post.data.tags}
  backHref="/blog"
  backLabel="Back to Blog"
  heroImage={post.data.heroImage ?? post.data.image}
  heroCaption={post.data.heroCaption}
  readingTime={time}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <TableOfContents headings={headings} />
  <Content />
</Post>

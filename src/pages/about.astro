---
import Base from '../layouts/Base.astro';
---

<Base title="About" description="A little about me — the person behind the blog.">
  <div class="content-wrapper">
    <div class="page-header">
      <h1>About Me</h1>
    </div>

    <div class="about-content">
      <p>
        Hi! I'm [Your Name]. I'm a curious person who thinks too much, drinks too much coffee,
        and has opinions about things that probably don't matter but feel very important at 2am.
      </p>

      <p>
        This site is my little corner of the internet — a place to write about whatever I'm
        currently obsessed with, share things I've built, and leave a trail of the thoughts
        that pass through my head.
      </p>

      <h2>What I'm into</h2>
      <p>
        [Tell the reader what you're curious about — science, philosophy, technology, art,
        cooking, whatever. Make it yours.]
      </p>

      <h2>What I do</h2>
      <p>
        [Add a sentence or two about your work or background, if you'd like to share.]
      </p>

      <h2>Get in touch</h2>
      <p>
        The best way to reach me is [your preferred contact — email, Twitter/X handle, etc.].
        I like interesting conversations.
      </p>
    </div>
  </div>
</Base>

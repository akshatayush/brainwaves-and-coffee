---
interface SearchItem {
  title: string;
  description: string;
  tags: string[];
  href: string;
  type: 'post' | 'project';
}

interface Props {
  items: SearchItem[];
}

const { items } = Astro.props;
const allTags = [...new Set(items.flatMap(i => i.tags))].sort();
---

<div id="search-modal" class="search-modal" hidden role="dialog" aria-modal="true" aria-label="Search">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-panel">
    <div class="search-header">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input id="search-input" type="search" placeholder="Search posts and projects…" autocomplete="off" spellcheck="false" />
      <button id="search-close" class="search-close" aria-label="Close search">✕</button>
    </div>
    {allTags.length > 0 && (
      <div class="search-tag-filters" id="search-tag-filters">
        {allTags.map(tag => (
          <button class="search-tag-btn" data-filter-tag={tag}>{tag}</button>
        ))}
      </div>
    )}
    <div id="search-results" class="search-results"></div>
  </div>
</div>

<script define:vars={{ items }}>
  const modal = document.getElementById('search-modal');
  const backdrop = document.getElementById('search-backdrop');
  const input = document.getElementById('search-input');
  const closeBtn = document.getElementById('search-close');
  const resultsEl = document.getElementById('search-results');
  const tagFiltersEl = document.getElementById('search-tag-filters');

  let activeTags = new Set();

  function openModal(preTag) {
    if (preTag) {
      activeTags = new Set([preTag]);
      updateTagButtons();
    }
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    setTimeout(() => input.focus(), 50);
    render();
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
    input.value = '';
    activeTags = new Set();
    updateTagButtons();
  }

  function updateTagButtons() {
    if (!tagFiltersEl) return;
    tagFiltersEl.querySelectorAll('.search-tag-btn').forEach(btn => {
      btn.classList.toggle('active', activeTags.has(btn.dataset.filterTag));
    });
  }

  function matches(item, query) {
    const tagMatch = [...activeTags].every(t => item.tags.includes(t));
    if (!tagMatch) return false;
    if (!query) return true;
    const haystack = (item.title + ' ' + item.description).toLowerCase();
    const queryWords = query.toLowerCase().split(/\s+/).filter(Boolean);
    // Use starts-with word boundary check for partial matching
    return queryWords.every(w => {
      const escaped = w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      return new RegExp(`\\b${escaped}`).test(haystack);
    });
  }

  function render() {
    const query = input.value.trim();
    const filtered = items.filter(item => matches(item, query));

    if (filtered.length === 0) {
      resultsEl.innerHTML = '<p class="search-empty">No results found.</p>';
      return;
    }

    resultsEl.innerHTML = filtered.map(item => `
      <a href="${item.href}" class="search-result-item">
        <div class="search-result-meta">
          <span class="search-result-type">${item.type === 'post' ? 'Post' : 'Project'}</span>
          ${item.tags.map(t => `<span class="tag" data-search-tag="${t}">${t}</span>`).join('')}
        </div>
        <div class="search-result-title">${item.title}</div>
        <div class="search-result-desc">${item.description}</div>
      </a>
    `).join('');
  }

  // Open from Nav or other triggers
  document.addEventListener('open-search', (e) => {
    const tag = e.detail?.tag ?? null;
    if (!modal.hidden && tag) {
      // Already open — just toggle the tag
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
      } else {
        activeTags.add(tag);
      }
      updateTagButtons();
      render();
    } else {
      openModal(tag);
    }
  });

  // Intercept tag clicks on PostCards (delegated)
  document.addEventListener('click', (e) => {
    const tagEl = e.target.closest('[data-search-tag]');
    if (tagEl) {
      e.preventDefault();
      e.stopPropagation();
      document.dispatchEvent(new CustomEvent('open-search', { detail: { tag: tagEl.dataset.searchTag } }));
    }
  }, true); // capture phase so we beat the <a> link

  // Close triggers
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (modal.hidden) openModal(null);
      else closeModal();
    }
    if (e.key === 'Escape' && !modal.hidden) {
      closeModal();
    }
  });

  // Search input
  input.addEventListener('input', render);

  // Tag filter buttons
  if (tagFiltersEl) {
    tagFiltersEl.addEventListener('click', (e) => {
      const btn = e.target.closest('.search-tag-btn');
      if (!btn) return;
      const tag = btn.dataset.filterTag;
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
      } else {
        activeTags.add(tag);
      }
      updateTagButtons();
      render();
    });
  }
</script>

---
// Coffee-themed decorative sprites for side margins
// Hidden on screens < 1100px where there's no margin space
---

<div class="coffee-decor-container" aria-hidden="true">
  <!-- ========== LEFT SIDE ========== -->

  <!-- Bean 1 — top left, STATIONARY anchor -->
  <svg class="coffee-sprite" style="top: 5%; left: calc(50% - 590px); transform: rotate(25deg);" width="81" height="53" viewBox="0 0 28 18" fill="none">
    <ellipse cx="14" cy="9" rx="13" ry="8" fill="currentColor"/>
    <path d="M14 1.5c-1 3-1 10 0 15" stroke="var(--parchment)" stroke-width="1.2" stroke-linecap="round"/>
    <path d="M6 4c2-1 5-1 7 0" stroke="var(--parchment)" stroke-width="0.6" stroke-linecap="round" opacity="0.25"/>
  </svg>

  <!-- Bean 2 — upper left, STATIONARY anchor -->
  <svg class="coffee-sprite" style="top: 15%; left: calc(50% - 640px); transform: rotate(-15deg);" width="65" height="43" viewBox="0 0 22 14" fill="none">
    <ellipse cx="11" cy="7" rx="10" ry="6" fill="currentColor"/>
    <path d="M11 1.5c-0.8 2.5-0.8 8 0 11" stroke="var(--parchment)" stroke-width="1" stroke-linecap="round"/>

  <!-- Drop 2 — very bottom left, drifts down -->
  <svg class="coffee-sprite" style="top: 93%; left: calc(50% - 580px);" data-parallax-speed="0.05" data-base-rotate="10" width="38" height="55" viewBox="0 0 14 20" fill="none">
    <path d="M7 2 C7 2 1 10 1 13a6 6 0 0012 0c0-3-6-11-6-11z" fill="currentColor"/>
    <path d="M5 9c1-2 2.5-3 4-2" stroke="var(--parchment)" stroke-width="0.6" stroke-linecap="round" opacity="0.25"/>
  </svg>

  <!-- ========== RIGHT SIDE ========== -->

  <!-- Bean cluster — top right, STATIONARY anchor -->
  <svg class="coffee-sprite" style="top: 6%; right: calc(50% - 610px); transform: rotate(-30deg);" width="73" height="48" viewBox="0 0 24 16" fill="none">
    <ellipse cx="12" cy="8" rx="11" ry="7" fill="currentColor"/>
    <path d="M12 1.5c-0.9 2.8-0.9 9 0 13" stroke="var(--parchment)" stroke-width="1.1" stroke-linecap="round"/>
    <path d="M6 3.5c1.5-0.8 4.5-0.8 6 0" stroke="var(--parchment)" stroke-width="0.5" stroke-linecap="round" opacity="0.2"/>
  </svg>

  <!-- Bean — upper right, STATIONARY anchor -->
  <svg class="coffee-sprite" style="top: 11%; right: calc(50% - 575px); transform: rotate(10deg);" width="60" height="40" viewBox="0 0 20 13" fill="none">
    <ellipse cx="10" cy="6.5" rx="9" ry="5.5" fill="currentColor"/>
    <path d="M10 1.5c-0.7 2-0.7 7.5 0 10" stroke="var(--parchment)" stroke-width="1" stroke-linecap="round"/>
    <path d="M5 3c1.2-0.6 3.5-0.6 4.5 0" stroke="var(--parchment)" stroke-width="0.4" stroke-linecap="round" opacity="0.2"/>
  </svg>

  <!-- Steam wisp cluster — upper right, drifts UP -->
  <svg class="coffee-sprite steam-float-alt" style="top: 22%; right: calc(50% - 620px);" data-parallax-speed="-0.05" data-base-rotate="0" width="60" height="106" viewBox="0 0 26 46" fill="none">
    <path d="M13 44 C13 44 19 32 15 24 C11 16 17 6 13 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.55"/>
    <path d="M7 42 C7 42 3 34 6 26 C9 18 5 10 8 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.35"/>
    <path d="M20 43 C20 43 23 35 21 28 C19 21 22 13 20 6" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" fill="none" opacity="0.22"/>
    <path d="M3 40 C3 40 1 36 2 31 C3 26 1 22 3 17" stroke="currentColor" stroke-width="0.7" stroke-linecap="round" fill="none" opacity="0.15"/>
  </svg>

  <!-- Sugar cube — mid right, drifts down -->
  <svg class="coffee-sprite" style="top: 34%; right: calc(50% - 640px);" data-parallax-speed="0.035" data-base-rotate="12" width="56" height="56" viewBox="0 0 18 18" fill="none">
    <rect x="1" y="1" width="16" height="16" rx="3" fill="currentColor"/>
    <rect x="4" y="4" width="4" height="4" rx="1" fill="var(--parchment)" opacity="0.3"/>
    <rect x="10" y="10" width="4" height="4" rx="1" fill="var(--parchment)" opacity="0.2"/>
    <rect x="10" y="4" width="3" height="3" rx="0.8" fill="var(--parchment)" opacity="0.15"/>
  </svg>

  <!-- Spoon — right, mouse reactive -->
  <svg class="coffee-sprite" style="top: 44%; right: calc(50% - 585px);" data-mouse-factor="10" width="75" height="94" viewBox="0 0 16 28" fill="none">
    <ellipse cx="8" cy="5" rx="5.5" ry="4.5" fill="currentColor"/>
    <ellipse cx="8" cy="5" rx="3.5" ry="2.8" fill="var(--parchment)" opacity="0.3"/>
    <ellipse cx="6.5" cy="3.8" rx="1.5" ry="1" fill="var(--parchment)" opacity="0.12"/>
    <rect x="6.5" y="9" width="3" height="17" rx="1.5" fill="currentColor"/>
  </svg>

  <!-- Bean — mid right, drifts down -->
  <svg class="coffee-sprite" style="top: 56%; right: calc(50% - 630px);" data-parallax-speed="0.04" data-base-rotate="-50" width="69" height="45" viewBox="0 0 22 14" fill="none">
    <ellipse cx="11" cy="7" rx="10" ry="6" fill="currentColor"/>
    <path d="M11 1.5c-0.8 2.5-0.8 8 0 11" stroke="var(--parchment)" stroke-width="1" stroke-linecap="round"/>
    <path d="M5 3.5c1.5-0.8 4-0.8 5.5 0" stroke="var(--parchment)" stroke-width="0.5" stroke-linecap="round" opacity="0.2"/>
  </svg>

  <!-- Steam wisp cluster 3 — right, drifts UP -->
  <svg class="coffee-sprite steam-float" style="top: 65%; right: calc(50% - 595px);" data-parallax-speed="-0.035" data-base-rotate="0" width="53" height="94" viewBox="0 0 24 44" fill="none">
    <path d="M12 42 C12 42 5 32 9 24 C13 16 7 8 12 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.5"/>
    <path d="M18 40 C18 40 22 30 19 22 C16 14 20 6 17 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none" opacity="0.3"/>
    <path d="M6 41 C6 41 3 34 5 28 C7 22 4 16 6 10" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" fill="none" opacity="0.2"/>
  </svg>

  <!-- Bean — lower right, mouse reactive -->
  <svg class="coffee-sprite" style="top: 75%; right: calc(50% - 625px);" data-mouse-factor="8" width="78" height="50" viewBox="0 0 26 17" fill="none">
    <ellipse cx="13" cy="8.5" rx="12" ry="7.5" fill="currentColor"/>
    <path d="M13 1.5c-1 2.8-1 10 0 14" stroke="var(--parchment)" stroke-width="1.1" stroke-linecap="round"/>
    <path d="M6 4c2-1 5-1 7 0" stroke="var(--parchment)" stroke-width="0.5" stroke-linecap="round" opacity="0.2"/>
  </svg>

  <!-- Drop — bottom right, drifts down -->
  <svg class="coffee-sprite" style="top: 86%; right: calc(50% - 580px);" data-parallax-speed="0.055" data-base-rotate="0" width="40" height="58" viewBox="0 0 12 18" fill="none">
    <path d="M6 2 C6 2 1 9 1 11.5a5 5 0 0010 0C11 9 6 2 6 2z" fill="currentColor"/>
    <path d="M4 8c0.8-1.5 2-2.2 3.2-1.5" stroke="var(--parchment)" stroke-width="0.5" stroke-linecap="round" opacity="0.25"/>
  </svg>

  <!-- Small bean — very bottom right, drifts down -->
  <svg class="coffee-sprite" style="top: 95%; right: calc(50% - 640px);" data-parallax-speed="0.03" data-base-rotate="-45" width="50" height="35" viewBox="0 0 16 11" fill="none">
    <ellipse cx="8" cy="5.5" rx="7" ry="4.5" fill="currentColor"/>
    <path d="M8 1.5c-0.5 1.8-0.5 5.5 0 8" stroke="var(--parchment)" stroke-width="0.8" stroke-linecap="round"/>
    <path d="M4 3c1-0.5 2.5-0.5 3.5 0" stroke="var(--parchment)" stroke-width="0.4" stroke-linecap="round" opacity="0.2"/>
  </svg>
</div>

<script>
  let scrollTicking = false;
  let mouseTicking = false;

  const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax-speed]');
  const mouseEls = document.querySelectorAll<HTMLElement>('[data-mouse-factor]');
  const viewH = window.innerHeight;

  // Apply initial rotation
  parallaxEls.forEach(el => {
    const rot = el.dataset.baseRotate ?? '0';
    el.style.transform = `rotate(${rot}deg)`;
  });

  // Scroll parallax with wrapping
  // Positive speed = drift down (beans, drops, solids)
  // Negative speed = drift up (steam wisps)
  window.addEventListener('scroll', () => {
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      parallaxEls.forEach(el => {
        const speed = parseFloat(el.dataset.parallaxSpeed!);
        const rot = el.dataset.baseRotate ?? '0';
        // Modular wrap: keep offset within ±50vh of origin
        const raw = y * speed;
        const wrapped = ((raw % viewH) + viewH) % viewH;
        const shifted = wrapped > viewH / 2 ? wrapped - viewH : wrapped;
        el.style.transform = `translateY(${shifted}px) rotate(${rot}deg)`;
      });
      scrollTicking = false;
    });
  });

  // Mouse parallax with smooth lerp
  let mouseX = 0, mouseY = 0;
  let currentX = 0, currentY = 0;

  document.addEventListener('mousemove', (e) => {
    mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
    mouseY = (e.clientY / window.innerHeight - 0.5) * 2;

    if (mouseTicking) return;
    mouseTicking = true;
    requestAnimationFrame(function update() {
      currentX += (mouseX - currentX) * 0.08;
      currentY += (mouseY - currentY) * 0.08;

      mouseEls.forEach(el => {
        const f = parseFloat(el.dataset.mouseFactor!);
        el.style.transform = `translate(${currentX * f}px, ${currentY * f}px)`;
      });

      if (Math.abs(mouseX - currentX) > 0.001 || Math.abs(mouseY - currentY) > 0.001) {
        requestAnimationFrame(update);
      } else {
        mouseTicking = false;
      }
    });
  });
</script>

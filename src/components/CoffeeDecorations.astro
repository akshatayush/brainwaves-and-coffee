  <!-- Steam wisp cluster — lower left, drifts UP -->
  <svg class="coffee-sprite steam-float" style="top: 57%; left: calc(50% - 615px);" data-parallax-speed="-0.04" data-base-rotate="0" width="69" height="113" viewBox="0 0 30 50" fill="none">
    <path d="M10 48 C10 48 3 36 7 26 C11 16 5 8 10 2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none" opacity="0.6"/>
    <path d="M16 46 C16 46 21 34 17 24 C13 14 19 6 15 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" opacity="0.4"/>
    <path d="M22 48 C22 48 26 38 23 30 C20 22 24 14 21 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none" opacity="0.25"/>
    <path d="M6 44 C6 44 2 38 4 32 C6 26 3 20 5 14" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" fill="none" opacity="0.18"/>
  </svg>

  <!-- Cup with saucer — mid-lower left, mouse reactive -->
  <svg class="coffee-sprite" style="top: 70%; left: calc(50% - 590px);" data-mouse-factor="14" width="90" height="85" viewBox="0 0 34 32" fill="none">
    <rect x="4" y="6" width="18" height="16" rx="2" fill="currentColor"/>
    <path d="M22 10c4 0 7 2 7 4.5s-3 4.5-7 4.5" stroke="currentColor" stroke-width="2" fill="none"/>
    <ellipse cx="13" cy="25" rx="13" ry="3" fill="currentColor" opacity="0.45"/>
    <rect x="5" y="22" width="16" height="3" rx="1.5" fill="currentColor" opacity="0.6"/>
    <path d="M9 5 C9 2 11 0 11 3" stroke="currentColor" stroke-width="1.3" opacity="0.5" fill="none"/>
    <path d="M14 4 C14 1 16 -1 16 2" stroke="currentColor" stroke-width="1.1" opacity="0.4" fill="none"/>
    <path d="M19 5 C19 2.5 20.5 1 20.5 3.5" stroke="currentColor" stroke-width="0.9" opacity="0.3" fill="none"/>
  </svg>

  <!-- Small bean — bottom left, drifts down -->
  <svg class="coffee-sprite" style="top: 82%; left: calc(50% - 635px);" data-parallax-speed="0.025" data-base-rotate="60" width="55" height="38" viewBox="0 0 18 12" fill="none">
    <ellipse cx="9" cy="6" rx="8" ry="5" fill="currentColor"/>
    <path d="M9 1.5c-0.6 2-0.6 6 0 9" stroke="var(--parchment)" stroke-width="0.9" stroke-linecap="round"/>
    <path d="M4 3c1.2-0.6 3-0.6 4 0" stroke="var(--parchment)" stroke-width="0.4" stroke-linecap="round" opacity="0.2"/>

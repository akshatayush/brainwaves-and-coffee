  </svg>

  <!-- Croissant — left, drifts down slowly -->
  <svg class="coffee-sprite" style="top: 26%; left: calc(50% - 600px);" data-parallax-speed="0.04" data-base-rotate="-20" width="88" height="63" viewBox="0 0 40 28" fill="none">
    <path d="M6 22 C2 18 1 12 4 7 C8 2 16 1 22 3 C28 5 33 10 35 16" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" fill="none"/>
    <path d="M6 22 C10 20 14 19 18 19 C24 19 30 17 35 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5"/>
    <path d="M10 7 C12 9 11 13 9 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.3"/>
    <path d="M17 5 C18 8 17 12 15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.3"/>
    <path d="M24 8 C24 11 23 14 21 16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none" opacity="0.2"/>
  </svg>

  <!-- Drop — mid left, drifts down -->
  <svg class="coffee-sprite" style="top: 38%; left: calc(50% - 630px);" data-parallax-speed="0.06" data-base-rotate="0" width="45" height="63" viewBox="0 0 14 20" fill="none">
    <path d="M7 2 C7 2 1 10 1 13a6 6 0 0012 0c0-3-6-11-6-11z" fill="currentColor"/>
    <path d="M5 9c1-2 2.5-3 4-2" stroke="var(--parchment)" stroke-width="0.6" stroke-linecap="round" opacity="0.25"/>
  </svg>

  <!-- Bean 3 — mid left, drifts down -->
  <svg class="coffee-sprite" style="top: 48%; left: calc(50% - 575px);" data-parallax-speed="0.03" data-base-rotate="40" width="60" height="40" viewBox="0 0 22 14" fill="none">
    <ellipse cx="11" cy="7" rx="10" ry="6" fill="currentColor"/>
    <path d="M11 1.5c-0.8 2.5-0.8 8 0 11" stroke="var(--parchment)" stroke-width="1" stroke-linecap="round"/>
    <path d="M5 3.5c1.5-0.8 4-0.8 5.5 0" stroke="var(--parchment)" stroke-width="0.5" stroke-linecap="round" opacity="0.2"/>

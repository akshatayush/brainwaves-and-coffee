---
import '../styles/PostCard.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate } from '../utils/formatDate';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  href: string;
  link?: string; // external link for projects
  image?: ImageMetadata;
}

const { title, description, date, tags = [], href, link, image } = Astro.props;

const formattedDate = formatDate(date);
---

<a href={href} class:list={['post-card', { 'post-card--with-image': !!image }]}>
  <div class="post-card-body">
    <div class="post-card-content">
      <div class="post-card-meta">
        <span class="post-card-date">{formattedDate}</span>
        {tags.length > 0 && (
          <div class="post-card-tags">
            {tags.map(tag => <span class="tag" data-search-tag={tag}>{tag}</span>)}
          </div>
        )}
      </div>
      <h3 class="post-card-title">{title}</h3>
      <p class="post-card-desc">{description}</p>
    </div>
    <span class="post-card-link">
      {link ? 'View project →' : 'Read more →'}
    </span>
  </div>
  {image && (
    <div class="post-card-thumb">
      <Image
        src={image}
        alt={title}
        widths={[480, 720, 960]}
        sizes="(max-width: 719px) calc(100vw - 2rem), 220px"
      />
    </div>
  )}
</a>

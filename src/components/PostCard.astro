---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  href: string;
  link?: string; // external link for projects
}

const { title, description, date, tags = [], href, link } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={href} class="post-card">
  <div class="post-card-meta">
    <span class="post-card-date">{formattedDate}</span>
    {tags.length > 0 && (
      <div class="post-card-tags">
        {tags.map(tag => <span class="tag" data-search-tag={tag}>{tag}</span>)}
      </div>
    )}
  </div>
  <h3 class="post-card-title">{title}</h3>
  <p class="post-card-desc">{description}</p>
  <span class="post-card-link">
    {link ? 'View project →' : 'Read more →'}
  </span>
</a>

---
import Base from './Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
  heroImage?: ImageMetadata;
  heroCaption?: string;
}

const {
  title,
  description,
  date,
  tags = [],
  backHref,
  backLabel,
  heroImage,
  heroCaption,
} = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <div class="content-wrapper">
    <a href={backHref} class="post-back">← {backLabel}</a>

    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <span>{formattedDate}</span>
        {tags.length > 0 && (
          <div class="post-card-tags">
            {tags.map(tag => <span class="tag" data-search-tag={tag}>{tag}</span>)}
          </div>
        )}
      </div>
    </header>

    {heroImage && (
      <figure class="post-hero-media">
        <Image
          src={heroImage}
          alt={title}
          widths={[720, 960, 1280]}
          sizes="(max-width: 768px) 100vw, 680px"
        />
        {heroCaption && <figcaption>{heroCaption}</figcaption>}
      </figure>
    )}

    <div class="post-content">
      <slot />
    </div>
  </div>
</Base>
